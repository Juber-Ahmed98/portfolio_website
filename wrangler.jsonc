{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Static-assets-only Worker: no server code, just serves the Astro build in
  // `dist/`. `npm run build` (astro build) produces `dist/`; `wrangler deploy`
  // uploads it. Custom domain `juberahmed.dev` is attached in the dashboard.
  "name": "portfolio-website",
  "compatibility_date": "2026-07-01",
  "assets": {
    "directory": "./dist",
    // Serve dist/404.html for unknown paths (built from src/pages/404.astro).
    "not_found_handling": "404-page"
  }
}

---
/**
 * The one document shell: head, meta, the stylesheet (inlined at build time)
 * and the body. Pages pass their own title, description and path.
 */
import "../styles/site.css";

interface Props {
  title: string;
  description: string;
  /** Path with slashes, e.g. "/work/jembatan/". */
  path: string;
  /** Static share image in public/. */
  ogImage?: string;
  ogImageAlt?: string;
  siteName?: string;
  /** The browser bar's colour on a phone: the sand where the first screen is sand. */
  themeColor?: string;
  /** JSON-LD for the page, if it has any. */
  jsonLd?: Record<string, unknown>;
  noindex?: boolean;
}

const {
  title,
  description,
  path,
  ogImage = "/og.jpg",
  ogImageAlt = "Juber Ahmed, frontend developer in Birmingham",
  siteName = "Juber Ahmed",
  themeColor = "#f5f5f2",
  jsonLd,
  noindex = false,
} = Astro.props;

const canonical = new URL(path, Astro.site).href;
const image = new URL(ogImage, Astro.site).href;
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content={themeColor} />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preload" href="/fonts/schibsted-grotesk-latin.woff2" as="font" type="font/woff2" crossorigin />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    {jsonLd && <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body id="top">
    <slot />
  </body>
</html>

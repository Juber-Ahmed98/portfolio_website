---
/**
 * The Jembatan recording in a phone, with a said/sent pair beside it. The
 * video is muted and loops; the script below fetches it a screen before it is
 * reached, plays it only while it is on screen and only once it can play
 * through, and never under prefers-reduced-motion (the poster shows instead).
 * A tap on the phone pauses it.
 */
import { jembatan } from "../content/site";

const example = jembatan.examples[jembatan.homeExample];
---

<div class="stage">
  <figure class="rec">
    <div class="device">
      <video
        src={jembatan.loop.src}
        poster={jembatan.loop.poster}
        muted
        loop
        playsinline
        preload="none"
        aria-label={jembatan.loop.alt}
        data-onscreen></video>
    </div>
    <figcaption>{jembatan.loop.caption}</figcaption>
  </figure>
  <div class="pair">
    <small>{jembatan.labels.said}</small>
    <p class="said">{example.said}</p>
    <small>{jembatan.labels.sent} {example.langLabel}</small>
    <p class="sent" lang={example.lang}>{example.sent}</p>
    <small class="note">{jembatan.labels.note}</small>
  </div>
</div>

<script is:inline>
  // Fetch a screen early; play while on screen, once it can play through; a tap
  // pauses it. Nothing at all for reduced motion. The clip's first frame is its
  // poster, so nothing jumps when it starts (the host can't seek: no Range).
  (function () {
    var v = document.querySelector('video[data-onscreen]');
    if (!v || matchMedia('(prefers-reduced-motion: reduce)').matches || !('IntersectionObserver' in window)) return;
    var phone = v.parentNode, on = false, held = false, fetched = false;
    function go() {
      if (!on || held || !fetched || v.readyState < 4) return;
      v.play().catch(function () {});
    }
    v.addEventListener('canplaythrough', go);
    new IntersectionObserver(function (e, o) {
      if (!e[0].isIntersecting) return;
      o.disconnect(); fetched = true; v.preload = 'auto'; v.load();
    }, { rootMargin: '0px 0px 100% 0px' }).observe(v);
    new IntersectionObserver(function (e) {
      on = e[0].isIntersecting; on ? go() : v.pause();
    }, { threshold: 0.35 }).observe(v);
    phone.setAttribute('role', 'button');
    phone.setAttribute('tabindex', '0');
    phone.setAttribute('aria-label', 'Pause the recording');
    phone.setAttribute('aria-pressed', 'false');
    function toggle() {
      held = !held; phone.setAttribute('aria-pressed', String(held));
      held ? v.pause() : go();
    }
    phone.addEventListener('click', toggle);
    phone.addEventListener('keydown', function (e) {
      if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); toggle(); }
    });
  })();
</script>
